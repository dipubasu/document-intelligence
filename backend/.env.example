# --- Server ---
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# --- Storage ---
DB_PATH=./data/app.sqlite
UPLOAD_DIR=./uploads

# --- Upload limits ---
MAX_FILE_SIZE_MB=50
MAX_FILES_PER_UPLOAD=10

# --- PDF ---
MAX_PDF_PAGES=1500

# --- Worker ---
WORKER_CONCURRENCY=2
WORKER_POLL_MS=1500
JOB_MAX_ATTEMPTS=3

# --- LLM (Groq) ---
# Model name অনুমানে বসাবে না, Groq এর current docs দেখে বসাও
GROQ_API_KEY=
GROQ_MODEL=

# --- Embeddings (Gemini) ---
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=